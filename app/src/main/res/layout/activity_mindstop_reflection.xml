<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/reflection_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/reflection_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mindstop_reflection_subtitle"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Mindstop.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLow">

                <TextView
                    android:id="@+id/reflection_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurface" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/mindstop_reflection_outcome_label"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorOnSurface" />

            <RadioGroup
                android:id="@+id/reflection_outcome_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/reflection_outcome_done"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/mindstop_reflection_outcome_done" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/reflection_outcome_partial"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/mindstop_reflection_outcome_partial" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/reflection_outcome_not_done"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/mindstop_reflection_outcome_not_done" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/reflection_outcome_switched"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/mindstop_reflection_outcome_switched" />
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/mindstop_reflection_reasons_label"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorOnSurface" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/reflection_reasons_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:singleSelection="false">

                <com.google.android.material.chip.Chip
                    android:id="@+id/reflection_reason_recs"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mindstop_reflection_reason_recs" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/reflection_reason_comments"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mindstop_reflection_reason_comments" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/reflection_reason_forgot"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mindstop_reflection_reason_forgot" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/reflection_reason_fatigue"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mindstop_reflection_reason_fatigue" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/reflection_reason_rest"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mindstop_reflection_reason_rest" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/reflection_reason_other"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mindstop_reflection_reason_other" />
            </com.google.android.material.chip.ChipGroup>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/reflection_save"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/mindstop_reflection_save" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/reflection_skip"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/mindstop_reflection_skip" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
